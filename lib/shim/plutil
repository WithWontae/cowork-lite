#!/bin/bash
# plutil이 없는 시스템(Windows Git Bash 등)에서 PATH 앞에 놓이는 호환 shim. 실제 일은 plutil.js가 한다.
# MSYS가 `/custom/root` 같은 "값" 인자를 Windows 경로로 바꿔 버리므로 자동 변환을 끄고,
# 파일 경로(-o 다음 인자, 마지막 인자)만 직접 변환한다.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export MSYS2_ARG_CONV_EXCL='*'
args=("$@")
n=${#args[@]}
winpath() {
  case "$1" in
    -|/dev/null|"") printf '%s' "$1" ;;
    *) if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi ;;
  esac
}
i=0
while [ "$i" -lt "$n" ]; do
  if [ "${args[$i]}" = "-o" ] && [ $((i+1)) -lt "$n" ]; then
    args[$((i+1))]="$(winpath "${args[$((i+1))]}")"
  fi
  i=$((i+1))
done
if [ "$n" -gt 0 ]; then args[$((n-1))]="$(winpath "${args[$((n-1))]}")"; fi
# Node 위치: 환경변수 > Windows 표준 설치 위치 > PATH. (테스트가 PATH에 가짜 node를 둘 수 있어 PATH는 마지막)
NODE_BIN="${COWORK_LITE_NODE:-}"
if [ -z "$NODE_BIN" ]; then
  for c in "${PROGRAMFILES:-/c/Program Files}/nodejs/node.exe" "/c/Program Files/nodejs/node.exe"; do
    [ -x "$c" ] && { NODE_BIN="$c"; break; }
  done
fi
[ -n "$NODE_BIN" ] || NODE_BIN="$(command -v node)" || { echo "plutil: node를 찾을 수 없습니다" >&2; exit 1; }
exec "$NODE_BIN" "$(winpath "$HERE/plutil.js")" "${args[@]}"
